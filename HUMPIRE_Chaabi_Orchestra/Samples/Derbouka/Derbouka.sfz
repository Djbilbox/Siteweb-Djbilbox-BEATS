<region> sample=ka/derbouka_ka_hard_rr3.wav lokey=40 hikey=40 seq_position=3

// ---------- SLAP

<group>
lovel=1 hivel=80 seq_length=2 pitch_keycenter=41

<region> sample=slap/derbouka_slap_soft_rr1.wav lokey=41 hikey=42 seq_position=1
<region> sample=slap/derbouka_slap_soft_rr2.wav lokey=41 hikey=42 seq_position=2

<group>
lovel=81 hivel=127 seq_length=2 pitch_keycenter=41

<region> sample=slap/derbouka_slap_hard_rr1.wav lokey=41 hikey=42 seq_position=1
