// HUMPIRE CHAABI ORCHESTRA - Derbouka
// Generated by tools/make_placeholders.py - SFZ format (open, royalty-free)

<control>
default_path=samples/

<global>
// Percussion: one_shot, no pitch tracking. DUM 36-37 / TEK 38-39 / KA 40 / SLAP 41-42 / GHOST 43-44
loop_mode=one_shot pitch_keytrack=0 ampeg_release=0.08


// ---------- DUM

<group>
lovel=1 hivel=80 seq_length=3 pitch_keycenter=36

<region> sample=dum/derbouka_dum_soft_rr1.wav lokey=36 hikey=37 seq_position=1
<region> sample=dum/derbouka_dum_soft_rr2.wav lokey=36 hikey=37 seq_position=2
<region> sample=dum/derbouka_dum_soft_rr3.wav lokey=36 hikey=37 seq_position=3

<group>
lovel=81 hivel=127 seq_length=3 pitch_keycenter=36

<region> sample=dum/derbouka_dum_hard_rr1.wav lokey=36 hikey=37 seq_position=1
<region> sample=dum/derbouka_dum_hard_rr2.wav lokey=36 hikey=37 seq_position=2
<region> sample=dum/derbouka_dum_hard_rr3.wav lokey=36 hikey=37 seq_position=3

// ---------- TEK

