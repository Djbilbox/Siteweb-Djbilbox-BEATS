<region> sample=tek/derbouka_tek_soft_rr2.wav lokey=38 hikey=39 seq_position=2
<region> sample=tek/derbouka_tek_soft_rr3.wav lokey=38 hikey=39 seq_position=3

<group>
lovel=81 hivel=127 seq_length=3 pitch_keycenter=38

<region> sample=tek/derbouka_tek_hard_rr1.wav lokey=38 hikey=39 seq_position=1
<region> sample=tek/derbouka_tek_hard_rr2.wav lokey=38 hikey=39 seq_position=2
<region> sample=tek/derbouka_tek_hard_rr3.wav lokey=38 hikey=39 seq_position=3

// ---------- KA

<group>
lovel=1 hivel=80 seq_length=3 pitch_keycenter=40

<region> sample=ka/derbouka_ka_soft_rr1.wav lokey=40 hikey=40 seq_position=1
<region> sample=ka/derbouka_ka_soft_rr2.wav lokey=40 hikey=40 seq_position=2
<region> sample=ka/derbouka_ka_soft_rr3.wav lokey=40 hikey=40 seq_position=3

