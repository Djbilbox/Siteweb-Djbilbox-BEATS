// HUMPIRE CHAABI ORCHESTRA - Mandole
// Generated by tools/make_placeholders.py - SFZ format (open, royalty-free)

<control>
default_path=samples/

<global>
// Keyswitch: 12 = plectrum (default), 13 = tremolo (sustained loop)
sw_lokey=12 sw_hikey=23 sw_default=12
ampeg_release=0.30


